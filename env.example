# Sigillum — Variables de entorno requeridas
# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube al repositorio (ver .gitignore).
#
# Requisito Zero Data Retention:
#   La API key debe pertenecer a una organización con contrato ZDR activo
#   o su equivalente de "no entrenar con mis datos" en el proveedor elegido.
#
# ── Selección de proveedor ──────────────────────────────────────────────
# AI_PROVIDER=openai      -> API "chat completions" compatible con OpenAI
#                            (Mistral, OpenAI, Groq, DeepSeek, Ollama, LM Studio, etc.)
# AI_PROVIDER=anthropic   -> Anthropic Messages API nativa (Claude)
# Si se omite AI_PROVIDER y hay una ANTHROPIC_API_KEY configurada, se usa
# 'anthropic' automáticamente; en caso contrario, 'openai'.
AI_PROVIDER=openai

# ── Opción A: proveedor OpenAI-compatible (Mistral por defecto) ────────
# Uso en compilación:
#   flutter build apk --dart-define=AI_API_KEY=... --dart-define=AI_PROVIDER=openai
AI_API_KEY=REEMPLAZA_CON_TU_KEY
AI_ENDPOINT=https://api.mistral.ai/v1/chat/completions
AI_MODEL=mistral-medium-latest

# ── Opción B: Anthropic (Claude) nativo ─────────────────────────────────
# Uso en compilación:
#   flutter build apk --dart-define=ANTHROPIC_API_KEY=sk-ant-... --dart-define=AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REEMPLAZA_CON_TU_KEY
ANTHROPIC_MODEL=claude-sonnet-5
